{"arguments":{"script":"\n// Force reload and check console\nreturn new Promise((resolve) => {\n  // Wait a moment then check state\n  setTimeout(() => {\n    const mainContent = document.querySelector('.main-content');\n    const allElements = document.querySelectorAll('*');\n    const classNames = new Set();\n    allElements.forEach(el => {\n      if (el.className && typeof el.className === 'string') {\n        el.className.split(' ').forEach(c => classNames.add(c));\n      }\n    });\n    \n    resolve({\n      mainInnerHTML: mainContent?.innerHTML || 'none',\n      totalElements: allElements.length,\n      uniqueClasses: Array.from(classNames).sort(),\n      bodyHTML: document.body.innerHTML.substring(0, 2000)\n    });\n  }, 500);\n});\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-12-06 02:19:09.427","tool":"puppeteer_evaluate"}
