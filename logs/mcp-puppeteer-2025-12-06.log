{"arguments":{"script":"\n// Get the actual error details\nreturn new Promise((resolve) => {\n  // Reload and capture errors\n  const capturedErrors = [];\n  const originalConsoleError = console.error;\n  console.error = function(...args) {\n    capturedErrors.push(args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' '));\n    originalConsoleError.apply(console, args);\n  };\n  \n  // Give it time to capture\n  setTimeout(() => {\n    console.error = originalConsoleError;\n    resolve({\n      errors: capturedErrors,\n      url: window.location.href,\n      pathname: window.location.pathname\n    });\n  }, 100);\n});\n"},"level":"debug","message":"Tool call received","service":"mcp-puppeteer","timestamp":"2025-12-06 02:19:26.298","tool":"puppeteer_evaluate"}
