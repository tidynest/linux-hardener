{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux System Hardener",
  "version": "0.1.0",
  "identifier": "com.ericjingryd.linux-hardener",
  "build": {
    "frontendDist": "../crates/hardener-ui/dist",
    "beforeDevCommand": "cd crates/hardener-ui && trunk serve",
    "beforeBuildCommand": "cd crates/hardener-ui && trunk build --release",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Linux System Hardener",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}