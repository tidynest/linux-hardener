{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Hardener",
  "version": "1.9.1",
  "identifier": "com.ericjingryd.linux-hardener",
  "build": {
    "frontendDist": "../crates/hardener-ui/dist",
    "beforeDevCommand": "cd \"${HARDENER_UI_DIR:-crates/hardener-ui}\" && trunk serve",
    "beforeBuildCommand": "cd \"${HARDENER_UI_DIR:-crates/hardener-ui}\" && trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Linux Hardener",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "Apache-2.0 AND OFL-1.1",
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/linux-hardener/copyright": "../packaging/debian/copyright"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/linux-hardener/LICENSE": "../LICENSE",
          "/usr/share/licenses/linux-hardener/LICENSE-noto-sans.txt": "../crates/hardener-compliance/src/fonts/LICENSE-noto-sans.txt",
          "/usr/share/licenses/linux-hardener/LICENSE-ibm-plex-sans.txt": "../crates/hardener-ui/fonts/LICENSE-ibm-plex-sans.txt",
          "/usr/share/licenses/linux-hardener/LICENSE-martian-mono.txt": "../crates/hardener-ui/fonts/LICENSE-martian-mono.txt"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/licenses/linux-hardener/LICENSE": "../LICENSE",
          "/usr/share/licenses/linux-hardener/LICENSE-noto-sans.txt": "../crates/hardener-compliance/src/fonts/LICENSE-noto-sans.txt",
          "/usr/share/licenses/linux-hardener/LICENSE-ibm-plex-sans.txt": "../crates/hardener-ui/fonts/LICENSE-ibm-plex-sans.txt",
          "/usr/share/licenses/linux-hardener/LICENSE-martian-mono.txt": "../crates/hardener-ui/fonts/LICENSE-martian-mono.txt"
        }
      }
    }
  }
}