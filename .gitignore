# Rust build artifacts
/target
**/*.rs.bk
*.rlib

# Editor swap files
*.swp
*.swo
*~

# OS-specific files
.DS_Store
Thumbs.db

# SQLite databases (may contain sensitive checkpoint data)
*.db
*.db-shm
*.db-wal

# Environment files (may contain credentials)
.env
.env.*

# Backup files created by hardener tool
*.backup-*
*_backup_*

# IDE-specific
.idea/
.vscode/settings.json

# MCP configuration (personal/machine-specific)
.mcp.json

# Local security CI gate configuration (machine-specific)
.rust-sec-ci.toml

# WASM build artifacts (entire dist/ is Trunk-generated)
crates/hardener-ui/dist/

# Theme experiments (future feature, not yet ready for distribution)
crates/hardener-ui/themes/

# Internal development documents (not for public repositories)
SSH_CLI_IMPLEMENTATION.md
/HANDOFF.md
docs/HANDOFF.md
docs/NEXT-SESSION-PROMPT.md
docs/QUESTIONS-FOR-MAINTAINER.md
docs/SSH_REMOTE_PLAN.md
