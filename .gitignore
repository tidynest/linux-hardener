docs/archive/tauri-plus-leptos-development-on-arch-linux-with-hyprland.md
MCP_INSTRUCTIONS.md
docs/superpowers/

# Local development logs
logs/

# Playwright MCP artifacts
.playwright-mcp/

# Node.js dependencies (GUI test suite)
node_modules/

# Debug screenshots
pics-debug/

# Root-level lockfile (no package.json at root)
package-lock.json

# Python bytecode, written by any run of scripts/validate/
__pycache__/
*.pyc

# Python virtual environments
.venv/

# Cross-distro test output
test-results/

# Claude Code settings (user-specific)
.claude/

# Git worktrees (isolated development)
.worktrees/

# makepkg build artifacts
packaging/src/
packaging/pkg/
packaging/*.pkg.tar*
packaging/*.tar.gz
packaging/*.tar.zst


# Brainstorming visual-companion scratch
.superpowers/

# CodeGraphContext index configuration (per-developer tooling, auto-generated)
.cgcignore

# cargo-mutants run artefacts (regenerable; 3 MB and full of absolute paths)
mutants.out/
